        province_code,
        county_code,
        vaccine_type,
        unit_code,
    )


# =========================================================
# Alerts
# =========================================================


@router.get("/alerts")
def vaccination_alerts(
    province_code: str | None = Query(None),
    db: Session = Depends(get_db),
    current_user=Depends(get_current_user),
):
    allowed_county_ids = get_allowed_county_ids(
        db,
        current_user,
    )

    # Global users can use the existing province-level
    # implementation directly.
    if allowed_county_ids is None:
        return alerts(
            db,
            province_code,
        )

    # County-scoped users receive only their county data.
    county_code = _resolve_county_scope(
        db,
        current_user,
        None,
    )

    result = alerts(
        db,
        province_code,
    )

    if not isinstance(result, list):
        return result

    return [
        row for row in result if str(row.get("county_code", "")).strip() == county_code
    ]


