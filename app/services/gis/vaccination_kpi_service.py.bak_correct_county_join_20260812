def vaccine_county_report(
    db: Session,
    vaccine_type: str,
    province_code: str | None = None,
) -> list[dict[str, Any]]:
    """
    Management report for ALL counties in GIS master data.

    Counties without any record for the selected vaccine are
    explicitly returned as NO_COVERAGE / CRITICAL.
    """

    params: dict[str, Any] = {
        "vaccine_type": vaccine_type,
    }

    province_clause = ""

    if province_code:
        province_clause = """
            AND p.province_code = :province_code
        """
        params["province_code"] = province_code

    q = text(
        f"""
        SELECT
            c.id AS county_id,
            c.county_code,
            c.county_name,

            COALESCE(m.units, 0) AS master_units,
            COALESCE(m.master_animals, 0) AS master_animals,

            COALESCE(v.records, 0) AS records,
            COALESCE(v.vaccinated_animals, 0)
                AS vaccinated_animals,
            COALESCE(v.adverse_events, 0)
                AS adverse_events

        FROM gis_counties c

        JOIN gis_provinces p
          ON p.id = c.province_id

        LEFT JOIN (
            SELECT
                county_id,
                COUNT(*) AS units,
                COALESCE(
                    SUM(
                        COALESCE(sheep_count, 0)
                        + COALESCE(cattle_count, 0)
                        + COALESCE(goat_count, 0)
                        + COALESCE(horse_count, 0)
                        + COALESCE(dog_count, 0)
                        + COALESCE(camel_count, 0)
                        + COALESCE(buffalo_count, 0)
                    ),
                    0
                ) AS master_animals
            FROM gis_epidemiology_units
            WHERE is_active = TRUE
            GROUP BY county_id
        ) m
          ON m.county_id = c.id

        LEFT JOIN (
            SELECT
                county_code,
                COUNT(*) AS records,
                COALESCE(
                    SUM(vaccinated_animals),
                    0
                ) AS vaccinated_animals,
                COALESCE(
                    SUM(shock_count),
                    0
                )
                + COALESCE(
                    SUM(death_count),
                    0
                )
                + COALESCE(
                    SUM(abortion_count),
                    0
                )
                + COALESCE(
                    SUM(hypersensitivity_count),
                    0
                )
                + COALESCE(
                    SUM(local_complication_count),
                    0
                ) AS adverse_events
            FROM {VACCINATION_TABLE}
            WHERE vaccine_type = :vaccine_type
            GROUP BY county_code
        ) v
          ON v.county_code = c.county_code

        WHERE 1 = 1
        {province_clause}

        ORDER BY
            c.county_name NULLS LAST
        """
    )

    rows = db.execute(q, params).mappings().all()

    result: list[dict[str, Any]] = []

    for row in rows:
        master_animals = int(
            row["master_animals"] or 0
        )

        vaccinated = int(
            row["vaccinated_animals"] or 0
        )

        records = int(
            row["records"] or 0
        )

        denominator = master_animals

        if denominator <= 0 and records > 0:
            fallback = db.execute(
                text(
                    f"""
                    SELECT
                        COALESCE(
                            SUM(total_animals),
                            0
                        ) AS total_animals
                    FROM {VACCINATION_TABLE}
                    WHERE vaccine_type = :vaccine_type
                      AND county_code = :county_code
                    """
                ),
                {
                    "vaccine_type": vaccine_type,
                    "county_code": row["county_code"],
                },
            ).scalar_one()

            denominator = int(fallback or 0)

        remaining = max(
            denominator - vaccinated,
            0,
        )

        coverage = _pct(
            vaccinated,
            denominator,
        )

        if records == 0:
            status = "NO_COVERAGE"
            alert = True
            alert_severity = "CRITICAL"
            alert_message = (
                f"برای واکسن «{vaccine_type}» "
                "هیچ رکورد واکسیناسیونی در این شهرستان "
                "ثبت نشده است."
            )
        elif coverage < 50:
            status = "CRITICAL"
            alert = True
            alert_severity = "CRITICAL"
            alert_message = (
                "پوشش واکسیناسیون کمتر از ۵۰ درصد است."
            )
        elif coverage < 75:
            status = "WARNING"
            alert = True
            alert_severity = "WARNING"
            alert_message = (
                "پوشش واکسیناسیون نیازمند پیگیری است."
            )
        elif coverage < 90:
            status = "ON_TRACK"
            alert = False
            alert_severity = None
            alert_message = None
        else:
            status = "EXCELLENT"
            alert = False
            alert_severity = None
            alert_message = None

        result.append(
            {
                "vaccine_type": vaccine_type,
                "county_id": row["county_id"],
                "county_code": row["county_code"],
                "county_name": row["county_name"],
                "records": records,
                "units": int(row["master_units"] or 0),
                "total_animals": denominator,
                "vaccinated_animals": vaccinated,
                "remaining_animals": remaining,
                "coverage_percent": coverage,
                "adverse_events": int(
                    row["adverse_events"] or 0
                ),
                "status": status,
                "alert": alert,
                "alert_severity": alert_severity,
                "alert_message": alert_message,
            }
        )

    return result

def vaccine_unit_report(
    db: Session,
    vaccine_type: str,
    province_code: str | None = None,
    county_code: str | None = None,
) -> list[dict[str, Any]]:
    """
    Return ALL active epidemiological units from GIS master data.

    No vaccination record for the selected vaccine means:
        coverage = 0
        status = NO_COVERAGE
        priority = URGENT
        alert = True
    """

    params: dict[str, Any] = {
        "vaccine_type": vaccine_type,
    }

    province_clause = ""
    county_clause = ""

    if province_code:
        province_clause = """
            AND p.province_code = :province_code
        """
        params["province_code"] = province_code

    if county_code:
        county_clause = """
            AND c.county_code = :county_code
        """
        params["county_code"] = county_code

    q = text(
        f"""
        SELECT
            u.id,
            u.unit_code,
            u.unit_name,
            u.province_id,
            u.county_id,

            p.province_code,
            p.province_name,

            c.county_code,
            c.county_name,

            COALESCE(u.sheep_count, 0)
            + COALESCE(u.cattle_count, 0)
            + COALESCE(u.goat_count, 0)
            + COALESCE(u.horse_count, 0)
            + COALESCE(u.dog_count, 0)
            + COALESCE(u.camel_count, 0)
            + COALESCE(u.buffalo_count, 0)
                AS master_animals,

            COALESCE(v.records, 0)
                AS records,

            COALESCE(v.total_animals, 0)
                AS recorded_total_animals,

            COALESCE(v.eligible_animals, 0)
                AS eligible_animals,

            COALESCE(v.vaccinated_animals, 0)
                AS vaccinated_animals,

            COALESCE(v.adverse_events, 0)
                AS adverse_events

        FROM gis_epidemiology_units u

        JOIN gis_provinces p
          ON p.id = u.province_id

        LEFT JOIN gis_counties c
          ON c.id = u.county_id

        LEFT JOIN (
            SELECT
                epidemiology_unit_code,
                COUNT(*) AS records,

                COALESCE(
                    SUM(total_animals),
                    0
                ) AS total_animals,

                COALESCE(
                    SUM(eligible_animals),
                    0
                ) AS eligible_animals,

                COALESCE(
                    SUM(vaccinated_animals),
                    0
                ) AS vaccinated_animals,

                COALESCE(
                    SUM(shock_count),
                    0
                )
                + COALESCE(
                    SUM(death_count),
                    0
                )
                + COALESCE(
                    SUM(abortion_count),
                    0
                )
                + COALESCE(
                    SUM(hypersensitivity_count),
                    0
                )
                + COALESCE(
                    SUM(local_complication_count),
                    0
                ) AS adverse_events

            FROM {VACCINATION_TABLE}

            WHERE vaccine_type = :vaccine_type

            GROUP BY
                epidemiology_unit_code

        ) v
          ON v.epidemiology_unit_code =
             u.unit_code

        WHERE u.is_active = TRUE

        {province_clause}
        {county_clause}

        ORDER BY
            c.county_name NULLS LAST,
            u.unit_name NULLS LAST
        """
    )

    rows = db.execute(q, params).mappings().all()

    result: list[dict[str, Any]] = []

    for row in rows:
        records = int(row["records"] or 0)

        master_animals = int(
            row["master_animals"] or 0
        )

        recorded_total = int(
            row["recorded_total_animals"] or 0
        )

        eligible = int(
            row["eligible_animals"] or 0
        )

        vaccinated = int(
            row["vaccinated_animals"] or 0
        )

        if master_animals > 0:
            denominator = master_animals
        elif eligible > 0:
            denominator = eligible
        else:
            denominator = recorded_total

        remaining = max(
            denominator - vaccinated,
            0,
        )

        coverage = _pct(
            vaccinated,
            denominator,
        )

        if records == 0:
            status = "NO_COVERAGE"
            priority = "URGENT"
            alert = True
            alert_severity = "CRITICAL"
            alert_message = (
                f"برای واکسن «{vaccine_type}» "
                "هیچ رکورد واکسیناسیونی برای این واحد "
                "ثبت نشده است."
            )
        elif coverage < 50:
            status = "CRITICAL"
            priority = "HIGH"
            alert = True
            alert_severity = "CRITICAL"
            alert_message = (
                "پوشش این واحد کمتر از ۵۰ درصد است."
            )
        elif coverage < 75:
            status = "WARNING"
            priority = "MEDIUM"
            alert = True
            alert_severity = "WARNING"
            alert_message = (
                "پوشش این واحد نیازمند پیگیری است."
            )
        elif coverage < 90:
            status = "ON_TRACK"
            priority = "LOW"
            alert = False
            alert_severity = None
            alert_message = None
        else:
            status = "EXCELLENT"
            priority = "LOW"
            alert = False
            alert_severity = None
            alert_message = None

        result.append(
            {
                "vaccine_type": vaccine_type,
                "unit_id": row["id"],
                "unit_code": row["unit_code"],
                "unit_name": row["unit_name"],
                "province_id": row["province_id"],
                "province_code": row["province_code"],
                "province_name": row["province_name"],
                "county_id": row["county_id"],
                "county_code": row["county_code"],
                "county_name": row["county_name"],
                "records": records,
                "total_animals": denominator,
                "eligible_animals": eligible,
                "vaccinated_animals": vaccinated,
                "remaining_animals": remaining,
                "coverage_percent": coverage,
                "adverse_events": int(
                    row["adverse_events"] or 0
                ),
                "adverse_event_rate_percent": _pct(
                    int(row["adverse_events"] or 0),
                    vaccinated,
                ),
                "status": status,
                "priority": priority,
                "alert": alert,
                "alert_severity": alert_severity,
                "alert_message": alert_message,
            }
        )

    return result

def vaccine_management_report(
    db: Session,
    vaccine_type: str,
    province_code: str | None = None,
    county_code: str | None = None,
) -> dict[str, Any]:
    vaccine_rows = vaccines(
        db,
        province_code=province_code,
        county_code=county_code,
        vaccine_type=vaccine_type,
    )

    counties_rows = vaccine_county_report(
        db,
        vaccine_type=vaccine_type,
        province_code=province_code,
    )

    units_rows = vaccine_unit_report(
        db,
        vaccine_type=vaccine_type,
        province_code=province_code,
        county_code=county_code,
    )

    base = (
        vaccine_rows[0]
        if vaccine_rows
        else {
            "vaccine_type": vaccine_type,
            "vaccine_brand": None,
            "records": 0,
            "total_animals": 0,
            "eligible_animals": 0,
            "vaccinated_animals": 0,
            "coverage_percent": 0.0,
            "adverse_events": 0,
            "adverse_event_rate_percent": 0.0,
        }
    )

    total_units = len(units_rows)
    completed_units = sum(
        1
        for x in units_rows
        if x["coverage_percent"] >= 90
    )
    incomplete_units = total_units - completed_units
    critical_units = sum(
        1
        for x in units_rows
        if x["coverage_percent"] < 50
    )

    zero_vaccination_units = sum(
        1
        for x in units_rows
        if x["vaccinated_animals"] <= 0
    )

    total_remaining = sum(
        int(x["remaining_animals"] or 0)
        for x in units_rows
    )

    top_priority_units = sorted(
        units_rows,
        key=lambda x: (
            -int(x["remaining_animals"] or 0),
            float(x["coverage_percent"] or 0),
        ),
    )[:10]

    top_priority_counties = sorted(
        counties_rows,
        key=lambda x: (
            -int(x["remaining_animals"] or 0),
            float(x["coverage_percent"] or 0),
        ),
    )[:10]

    return {
        "vaccine": base,
        "summary": {
            "counties": len(counties_rows),
            "units": total_units,
            "completed_units": completed_units,
            "incomplete_units": incomplete_units,
            "critical_units": critical_units,
            "zero_vaccination_units": zero_vaccination_units,
            "total_remaining_animals": total_remaining,
        },
        "counties": counties_rows,
        "units": units_rows,
        "top_priority_counties": top_priority_counties,
        "top_priority_units": top_priority_units,
    }


