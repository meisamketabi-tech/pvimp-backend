        CREATE INDEX IF NOT EXISTS {MV_NAME}_unit_vaccine_animal_idx
        ON {MV_NAME} (epidemiology_unit_code, vaccine_type, animal_group)
    """)
    op.execute(f"ANALYZE {MV_NAME}")


def downgrade() -> None:
